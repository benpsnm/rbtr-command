    {
      "parameters": {
        "model": "claude-sonnet-4-5-20250929",
        "text": "=# Classify PSNM Outreach Reply Intent\n\nAnalyze this email reply to a PSNM outreach campaign and classify the sender's intent:\n\n**Subject:** {{ $json.email_subject }}\n**From:** {{ $json.email_from }}\n**Body:** {{ $json.email_body }}\n\n**Classification Options:**\n- **INTERESTED**: Expresses interest in PSNM services, wants to discuss, asks for rates, requests a call\n- **NOT_NOW**: Polite decline, \"maybe later\", \"we're good for now\", \"not at this time\"\n- **WRONG_CONTACT**: \"I don't handle this\", \"forward to X\", \"wrong department\"\n- **UNSUBSCRIBE**: Explicit request to stop emailing, remove from list, \"take me off your list\"\n- **ASKING_QUESTION**: Has a specific question about PSNM services, location, capabilities\n\n**Output format (JSON only):**\n{\n  \"intent\": \"INTERESTED|NOT_NOW|WRONG_CONTACT|UNSUBSCRIBE|ASKING_QUESTION\",\n  \"sentiment\": \"positive|neutral|negative\",\n  \"reasoning\": \"Brief explanation\",\n  \"key_points\": [\"extracted key points from the email\"],\n  \"suggested_action\": \"What Ben should do next\"\n}",
        "options": {
          "maxTokens": 1024,
          "temperature": 0.2
        }
      },
      "id": "claude-classify-intent",
      "name": "Claude: Classify Intent",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.8,
      "position": [910, 300],
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-api",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "psnm_outreach_replies",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "email_id": "={{ $('Extract Reply Data').item.json.email_id }}",
            "thread_id": "={{ $('Extract Reply Data').item.json.thread_id }}",
            "email_from": "={{ $('Extract Reply Data').item.json.email_from }}",
            "email_subject": "={{ $('Extract Reply Data').item.json.email_subject }}",
            "email_body": "={{ $('Extract Reply Data').item.json.email_body }}",
            "intent": "={{ $json.intent }}",
            "sentiment": "={{ $json.sentiment }}",
            "key_points": "={{ $json.key_points }}",
            "suggested_action": "={{ $json.suggested_action }}"
          }
        },
        "options": {}
      },
      "id": "supabase-insert-reply",
      "name": "Insert Reply to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1.1,
      "position": [1130, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-api",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "intent-check",
              "leftValue": "={{ $('Claude: Classify Intent').item.json.intent }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "switch-intent",
      "name": "Switch on Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE psnm_prospects\nSET status = 'hot',\n    last_contact = NOW(),\n    notes = CONCAT(COALESCE(notes, ''), '\\n[{{ $now.format('yyyy-MM-dd') }}] Reply received - INTERESTED')\nWHERE LOWER(email) = LOWER('{{ $('Extract Reply Data').item.json.email_from }}')\nOR LOWER(domain) = LOWER('{{ $('Extract Reply Data').item.json.email_from.split('@')[1] }}');",
        "options": {}
      },
      "id": "supabase-promote-hot",
      "name": "Promote to HOT Prospect",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1.1,
      "position": [1570, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-api",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
