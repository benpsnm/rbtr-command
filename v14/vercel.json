{
  "version": 2,
  "public": true,
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/cron-morning-brief",                   "schedule": "0 6 * * 1-5"  },
    { "path": "/api/cron-morning-brief?mode=psnm-brief",   "schedule": "0 6 * * 1-5"  },
    { "path": "/api/cron-morning-brief?mode=evening",      "schedule": "0 21 * * 1-5" },
    { "path": "/api/cron-backup",                          "schedule": "0 3 * * *"  },
    { "path": "/api/atlas?action=intel_harvest_daily",              "schedule": "0 6 * * *"  },
    { "path": "/api/atlas?action=intel_harvest_insolvency_daily",  "schedule": "15 6 * * *" },
    { "path": "/api/atlas?action=intel_harvest_defence_weekly",    "schedule": "30 6 * * 0" }
  ],
  "headers": [
    {
      "source": "/api/standalone/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://psnm-wms.vercel.app" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-rbtr-auth" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, GET, OPTIONS" }
      ]
    }
  ]
}
